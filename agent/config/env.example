# Copy to agent/.env.local or export these variables in the process environment.
# Never commit a populated credential file.

# Current SparseMAC-SemanticV2 planner, verifier, and analyzer.
SPARSEMAC_LUNA_API_KEY=
SPARSEMAC_LUNA_BASE_URL=https://your-openai-compatible-endpoint.example/v1
SPARSEMAC_LUNA_MODEL=gpt-5.6-luna
SPARSEMAC_LUNA_REASONING_EFFORT=medium
SPARSEMAC_LUNA_MAX_RETRIES=3

# Wan generation paths. Model weights are intentionally not part of Git.
SPARSEMAC_WAN_CHECKPOINT=/path/to/Wan2.1-T2V-1.3B
SPARSEMAC_PYTHON=/path/to/conda/env/bin/python
SPARSEMAC_GENERATOR_ROOT=/path/to/vedio-agent/agent/generation_backend
SPARSEMAC_WAN_SOURCE_ROOT=/path/to/vedio-agent/agent/generation_backend
SPARSEMAC_RUN_ROOT=/path/to/output/runs

# Optional remote execution and T2V-CompBench batch input.
SPARSEMAC_REMOTE=local
SPARSEMAC_PROJECT_DIR=/path/to/vedio-agent/agent
SPARSEMAC_LOG_ROOT=/path/to/output/logs
SPARSEMAC_T2VCOMPBENCH_PROMPT_DIR=/path/to/T2V-CompBench/prompts
SPARSEMAC_VQQA_MANIFEST=/path/to/vqqa/manifest.json

# Legacy clients. These are not used by sparsemac-semantic-v2.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
SPARSEMAC_LLAVA_PYTHON=
SPARSEMAC_LLAVA_ROOT=
SPARSEMAC_LLAVA_MODEL=
LLAVA_GPU_ID=0
